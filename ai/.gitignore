# Keep AI data directories available but ignore generated/downloaded content.
data/raw/*
!data/raw/.gitkeep

# Ignore common large generated outputs
*.csv
*.tsv
*.parquet
*.pkl
*.joblib
*.npy
*.npz
*.h5
*.hdf5
*.zip
*.gz
*.tar
*.tar.gz

# Ignore local notebooks outputs if added later
.ipynb_checkpoints/
research/outputs/
