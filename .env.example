DATABASE_URL=postgresql://postgres:postgres@db:5432/silentsepsis
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
SECRET_KEY=replace_this_with_a_secure_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
BOOTSTRAP_SECRET=change-me-in-production
REDIS_URL=redis://redis:6379/0
RISK_EVALUATION_INTERVAL_MINUTES=5
CORS_ALLOWED_ORIGINS=http://localhost:5173
LOGIN_RATE_LIMIT=5/minute
BOOTSTRAP_RATE_LIMIT=3/minute
DEFAULT_RATE_LIMIT=100/minute
ENVIRONMENT=development
# Set to false to disable the /metrics endpoint in production if desired
ENABLE_METRICS=true
